# Tamil Nadu Flood Prediction & Early Warning System - Configuration
APP_NAME="Tamil Nadu Flood Prediction & Early Warning System"
DEBUG=true

# Database (Default: SQLite, adaptable to PostgreSQL: postgresql://user:pass@localhost:5432/tn_flood_db)
DATABASE_URL=sqlite:///./flood_warning.db

# Operation Mode: Set to false only when connected to authenticated live CWC & IMD gateways
DEMO_MODE=true

# Weather API Provider (e.g. open-meteo, imd_aws)
WEATHER_API_PROVIDER=open-meteo
WEATHER_API_KEY=

# Early Warning Risk Thresholds (Expressed as ratio of Water Level / Danger Level)
THRESHOLD_MODERATE_RATIO=0.85
THRESHOLD_HIGH_RATIO=0.95
THRESHOLD_CRITICAL_RATIO=1.00

# Alert Duplicate Window in Hours
ALERT_DUPLICATE_WINDOW_HOURS=4
